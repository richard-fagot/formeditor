{
  "formatVersion": 5,
  "kind": "library",
  "questions": [
    {
      "id": "lq_date_sinistre",
      "key": "date_sinistre",
      "label": {
        "fr": "Date du sinistre",
        "en": "Date of the claim"
      },
      "type": "date",
      "required": true,
      "min": "sys.date_effet_contrat",
      "max": "$today()",
      "messages": {
        "min": {
          "fr": "Le sinistre est antérieur à la date d'effet du contrat.",
          "en": "The claim predates the contract."
        },
        "max": {
          "fr": "La date ne peut pas être dans le futur.",
          "en": "The date cannot be in the future."
        }
      },
      "defaultExpr": "$today()"
    },
    {
      "id": "lq_telephone",
      "key": "telephone",
      "label": {
        "fr": "Numéro de téléphone",
        "en": "Phone number"
      },
      "type": "text",
      "required": true,
      "pattern": "^0[1-9]( ?[0-9]{2}){4}$",
      "placeholder": {
        "fr": "06 12 34 56 78",
        "en": "06 12 34 56 78"
      },
      "messages": {
        "pattern": {
          "fr": "Numéro à 10 chiffres attendu.",
          "en": "10-digit number expected."
        }
      }
    }
  ],
  "blocks": [
    {
      "id": "blk_identite_tiers",
      "key": "identite_tiers",
      "title": {
        "fr": "Identité du tiers",
        "en": "Third party identity"
      },
      "description": "Identifie un tiers impliqué et son assureur.",
      "start": "bn_nom",
      "nodes": [
        {
          "kind": "question",
          "id": "bn_nom",
          "key": "nom",
          "label": {
            "fr": "Nom du tiers",
            "en": "Third party name"
          },
          "type": "text",
          "required": true,
          "maxLength": 100
        },
        {
          "kind": "question",
          "id": "bn_coordonnees",
          "key": "coordonnees",
          "label": {
            "fr": "Coordonnées de {nom}",
            "en": "{nom}'s contact details"
          },
          "description": "Structure non répétable : la réponse est un objet { adresse, code_postal, ville }.",
          "type": "structure",
          "required": true,
          "fields": [
            {
              "id": "bf_adresse",
              "key": "adresse",
              "label": {
                "fr": "Adresse",
                "en": "Address"
              },
              "type": "text",
              "required": true
            },
            {
              "id": "bf_code_postal",
              "key": "code_postal",
              "label": {
                "fr": "Code postal",
                "en": "Postcode"
              },
              "type": "text",
              "required": true,
              "pattern": "^[0-9]{5}$",
              "messages": {
                "pattern": {
                  "fr": "Code postal à 5 chiffres.",
                  "en": "5-digit postcode."
                }
              }
            },
            {
              "id": "bf_ville",
              "key": "ville",
              "label": {
                "fr": "Ville",
                "en": "City"
              },
              "type": "text",
              "required": true
            }
          ]
        },
        {
          "kind": "question",
          "id": "bn_assurance_connue",
          "key": "assurance_connue",
          "label": {
            "fr": "Connaissez-vous l'assureur de {nom} ?",
            "en": "Do you know {nom}'s insurer?"
          },
          "type": "tristate",
          "required": true,
          "labelSet": "ls_oui_non_nsp"
        },
        {
          "kind": "question",
          "id": "bn_compagnie",
          "key": "compagnie",
          "label": {
            "fr": "Compagnie d'assurance du tiers",
            "en": "Third party insurer"
          },
          "help": {
            "fr": "Celle qui couvre {nom} ({coordonnees.ville}) pour le sinistre du {date_sinistre}.",
            "en": "The one covering {nom} ({coordonnees.ville}) for the claim of {date_sinistre}."
          },
          "type": "text",
          "required": true
        },
        {
          "kind": "exit",
          "id": "bx_identifie",
          "name": "identifie",
          "label": {
            "fr": "Assureur du tiers connu",
            "en": "Third party insurer known"
          }
        },
        {
          "kind": "exit",
          "id": "bx_non_identifie",
          "name": "non_identifie",
          "label": {
            "fr": "Assureur du tiers inconnu",
            "en": "Third party insurer unknown"
          }
        }
      ],
      "edges": [
        {
          "id": "be_nom_coordonnees",
          "from": "bn_nom",
          "to": "bn_coordonnees"
        },
        {
          "id": "be_coordonnees_assurance",
          "from": "bn_coordonnees",
          "to": "bn_assurance_connue"
        },
        {
          "id": "be_assurance_compagnie",
          "from": "bn_assurance_connue",
          "to": "bn_compagnie",
          "when": "assurance_connue = true"
        },
        {
          "id": "be_assurance_sortie",
          "from": "bn_assurance_connue",
          "to": "bx_non_identifie"
        },
        {
          "id": "be_compagnie_sortie",
          "from": "bn_compagnie",
          "to": "bx_identifie"
        }
      ]
    }
  ],
  "labelSets": [
    {
      "id": "ls_oui_non_nsp",
      "key": "oui_non_nsp",
      "kind": "tristate",
      "yes": {
        "fr": "Oui",
        "en": "Yes"
      },
      "no": {
        "fr": "Non",
        "en": "No"
      },
      "unknown": {
        "fr": "Ne sait pas",
        "en": "Don't know"
      }
    },
    {
      "id": "ls_confirmation",
      "key": "confirmation",
      "kind": "boolean",
      "yes": {
        "fr": "Oui, je confirme",
        "en": "Yes, I confirm"
      },
      "no": {
        "fr": "Non, je corrige",
        "en": "No, I want to correct it"
      }
    }
  ]
}

{
  "formatVersion": 11,
  "kind": "library",
  "questions": [
    {
      "id": "lq_date_sinistre",
      "key": "date_sinistre",
      "label": {
        "fr": "Date du sinistre",
        "en": "Date of the claim"
      },
      "type": "date",
      "required": true,
      "min": "sys.date_effet_contrat",
      "max": "$today()",
      "messages": {
        "min": {
          "fr": "Le sinistre est antérieur à la date d'effet du contrat.",
          "en": "The claim predates the contract."
        },
        "max": {
          "fr": "La date ne peut pas être dans le futur.",
          "en": "The date cannot be in the future."
        }
      },
      "defaultExpr": "$today()"
    },
    {
      "id": "lq_telephone",
      "key": "telephone",
      "label": {
        "fr": "Numéro de téléphone",
        "en": "Phone number"
      },
      "type": "text",
      "required": true,
      "pattern": "^0[1-9]( ?[0-9]{2}){4}$",
      "placeholder": {
        "fr": "06 12 34 56 78",
        "en": "06 12 34 56 78"
      },
      "messages": {
        "pattern": {
          "fr": "Numéro à 10 chiffres attendu.",
          "en": "10-digit number expected."
        }
      }
    },
    {
      "id": "lq_souscripteur",
      "key": "souscripteur",
      "label": {
        "fr": "Souscripteur",
        "en": "Policyholder"
      },
      "description": "Coordonnées du souscripteur (EVO-007) : civilité, nom, mail, téléphone mobile et adresse.",
      "type": "structure",
      "fields": [
        {
          "id": "lf_civilite",
          "key": "civilite",
          "label": {
            "fr": "Civilité",
            "en": "Title"
          },
          "type": "civility",
          "required": true
        },
        {
          "id": "lf_nom",
          "key": "nom",
          "label": {
            "fr": "Nom",
            "en": "Last name"
          },
          "type": "text",
          "required": true
        },
        {
          "id": "lf_mail",
          "key": "mail",
          "label": {
            "fr": "Adresse mail",
            "en": "Email address"
          },
          "type": "email"
        },
        {
          "id": "lf_telephone",
          "key": "telephone",
          "label": {
            "fr": "Téléphone",
            "en": "Phone"
          },
          "type": "phone",
          "defaultCountry": "FR",
          "lineType": "mobile"
        },
        {
          "id": "lf_adresse",
          "key": "adresse",
          "label": {
            "fr": "Adresse",
            "en": "Address"
          },
          "type": "address",
          "defaultCountry": "FR",
          "verify": true
        }
      ]
    },
    {
      "id": "lq_identite",
      "key": "identite",
      "label": {
        "fr": "Vos coordonnées",
        "en": "Your contact details"
      },
      "description": "Identité complète réutilisable (EVO-009) : chaque instance peut masquer des champs (demande_remboursement n'affiche que nom, prénom et mail).",
      "type": "structure",
      "fields": [
        {
          "id": "li_civilite",
          "key": "civilite",
          "label": {
            "fr": "Civilité",
            "en": "Title"
          },
          "type": "civility",
          "required": true
        },
        {
          "id": "li_nom",
          "key": "nom",
          "label": {
            "fr": "Nom",
            "en": "Last name"
          },
          "type": "text",
          "required": true
        },
        {
          "id": "li_prenom",
          "key": "prenom",
          "label": {
            "fr": "Prénom",
            "en": "First name"
          },
          "type": "text",
          "required": true
        },
        {
          "id": "li_date_naissance",
          "key": "date_naissance",
          "label": {
            "fr": "Date de naissance",
            "en": "Date of birth"
          },
          "type": "date",
          "required": true,
          "max": "$today()"
        },
        {
          "id": "li_adresse",
          "key": "adresse",
          "label": {
            "fr": "Adresse",
            "en": "Address"
          },
          "type": "address",
          "required": true,
          "defaultCountry": "FR"
        },
        {
          "id": "li_mail",
          "key": "mail",
          "label": {
            "fr": "Adresse mail",
            "en": "Email address"
          },
          "type": "email",
          "required": true
        },
        {
          "id": "li_telephone",
          "key": "telephone",
          "label": {
            "fr": "Téléphone",
            "en": "Phone"
          },
          "type": "phone",
          "required": true,
          "defaultCountry": "FR"
        }
      ]
    }
  ],
  "fragments": [
    {
      "id": "blk_identite_tiers",
      "key": "identite_tiers",
      "title": {
        "fr": "Identité du tiers",
        "en": "Third party identity"
      },
      "description": "Identifie un tiers impliqué et son assureur.",
      "nodes": [
        {
          "kind": "question",
          "id": "bn_nom",
          "key": "nom",
          "label": {
            "fr": "Nom du tiers",
            "en": "Third party name"
          },
          "type": "text",
          "required": true,
          "maxLength": 100
        },
        {
          "kind": "question",
          "id": "bn_coordonnees",
          "key": "coordonnees",
          "label": {
            "fr": "Coordonnées de {nom}",
            "en": "{nom}'s contact details"
          },
          "description": "Structure non répétable : la réponse est un objet { adresse, code_postal, ville }.",
          "type": "structure",
          "required": true,
          "fields": [
            {
              "id": "bf_adresse",
              "key": "adresse",
              "label": {
                "fr": "Adresse",
                "en": "Address"
              },
              "type": "text",
              "required": true
            },
            {
              "id": "bf_code_postal",
              "key": "code_postal",
              "label": {
                "fr": "Code postal",
                "en": "Postcode"
              },
              "type": "text",
              "required": true,
              "pattern": "^[0-9]{5}$",
              "messages": {
                "pattern": {
                  "fr": "Code postal à 5 chiffres.",
                  "en": "5-digit postcode."
                }
              }
            },
            {
              "id": "bf_ville",
              "key": "ville",
              "label": {
                "fr": "Ville",
                "en": "City"
              },
              "type": "text",
              "required": true
            }
          ]
        },
        {
          "kind": "question",
          "id": "bn_telephone",
          "ref": "lq_telephone",
          "label": {
            "fr": "Téléphone de {nom} (si connu)",
            "en": "{nom}'s phone (if known)"
          },
          "required": false
        },
        {
          "kind": "question",
          "id": "bn_assurance_connue",
          "key": "assurance_connue",
          "label": {
            "fr": "Connaissez-vous l'assureur de {nom} ?",
            "en": "Do you know {nom}'s insurer?"
          },
          "type": "tristate",
          "required": true,
          "labelSet": "ls_oui_non_nsp"
        },
        {
          "kind": "question",
          "id": "bn_compagnie",
          "key": "compagnie",
          "label": {
            "fr": "Compagnie d'assurance du tiers",
            "en": "Third party insurer"
          },
          "help": {
            "fr": "Celle qui couvre {nom} ({coordonnees.ville}) pour le sinistre du {date_sinistre}.",
            "en": "The one covering {nom} ({coordonnees.ville}) for the claim of {date_sinistre}."
          },
          "type": "text",
          "required": true
        },
        {
          "kind": "exit",
          "id": "bx_identifie",
          "name": "identifie",
          "label": {
            "fr": "Assureur du tiers connu",
            "en": "Third party insurer known"
          }
        },
        {
          "kind": "exit",
          "id": "bx_non_identifie",
          "name": "non_identifie",
          "label": {
            "fr": "Assureur du tiers inconnu",
            "en": "Third party insurer unknown"
          }
        }
      ],
      "edges": [
        {
          "id": "be_nom_coordonnees",
          "from": "bn_nom",
          "to": "bn_coordonnees"
        },
        {
          "id": "be_coordonnees_telephone",
          "from": "bn_coordonnees",
          "to": "bn_telephone"
        },
        {
          "id": "be_telephone_assurance",
          "from": "bn_telephone",
          "to": "bn_assurance_connue"
        },
        {
          "id": "be_assurance_compagnie",
          "from": "bn_assurance_connue",
          "to": "bn_compagnie",
          "when": "assurance_connue = true"
        },
        {
          "id": "be_assurance_sortie",
          "from": "bn_assurance_connue",
          "to": "bx_non_identifie"
        },
        {
          "id": "be_compagnie_sortie",
          "from": "bn_compagnie",
          "to": "bx_identifie"
        }
      ]
    },
    {
      "id": "frg_identification_assure",
      "key": "identification_assure",
      "title": {
        "fr": "Identification de l'assuré",
        "en": "Policyholder identification"
      },
      "description": "Fragment réutilisable : identité de l'assuré ; numéro de sécurité sociale s'il est majeur, représentant légal sinon. Sorties implicites : num_secu et representant_legal.",
      "nodes": [
        {
          "kind": "question",
          "id": "fn_nom",
          "key": "nom",
          "label": {
            "fr": "Nom de l'assuré",
            "en": "Policyholder last name"
          },
          "type": "text",
          "required": true,
          "maxLength": 100
        },
        {
          "kind": "question",
          "id": "fn_prenom",
          "key": "prenom",
          "label": {
            "fr": "Prénom de l'assuré",
            "en": "Policyholder first name"
          },
          "type": "text",
          "required": true,
          "maxLength": 100
        },
        {
          "kind": "question",
          "id": "fn_date_naissance",
          "key": "date_naissance",
          "label": {
            "fr": "Date de naissance de {prenom}",
            "en": "{prenom}'s date of birth"
          },
          "type": "date",
          "required": true,
          "max": "$today()"
        },
        {
          "kind": "question",
          "id": "fn_majeur",
          "key": "majeur",
          "label": {
            "fr": "{prenom} est-il majeur ?",
            "en": "Is {prenom} of age?"
          },
          "type": "boolean",
          "required": true
        },
        {
          "kind": "question",
          "id": "fn_num_secu",
          "key": "num_secu",
          "label": {
            "fr": "Numéro de sécurité sociale",
            "en": "Social security number"
          },
          "type": "text",
          "required": true,
          "pattern": "^[12][0-9]{12}$",
          "messages": {
            "pattern": {
              "fr": "13 chiffres, commençant par 1 ou 2.",
              "en": "13 digits, starting with 1 or 2."
            }
          }
        },
        {
          "kind": "question",
          "id": "fn_representant_legal",
          "key": "representant_legal",
          "label": {
            "fr": "Nom du représentant légal de {prenom}",
            "en": "Name of {prenom}'s legal guardian"
          },
          "type": "text",
          "required": true
        }
      ],
      "edges": [
        {
          "id": "fe_nom_prenom",
          "from": "fn_nom",
          "to": "fn_prenom"
        },
        {
          "id": "fe_prenom_naissance",
          "from": "fn_prenom",
          "to": "fn_date_naissance"
        },
        {
          "id": "fe_naissance_majeur",
          "from": "fn_date_naissance",
          "to": "fn_majeur"
        },
        {
          "id": "fe_majeur_secu",
          "from": "fn_majeur",
          "to": "fn_num_secu",
          "when": "majeur = true",
          "caption": "Assuré majeur"
        },
        {
          "id": "fe_majeur_representant",
          "from": "fn_majeur",
          "to": "fn_representant_legal",
          "caption": "Assuré mineur"
        }
      ]
    }
  ],
  "labelSets": [
    {
      "id": "ls_oui_non_nsp",
      "key": "oui_non_nsp",
      "kind": "tristate",
      "yes": {
        "fr": "Oui",
        "en": "Yes"
      },
      "no": {
        "fr": "Non",
        "en": "No"
      },
      "unknown": {
        "fr": "Ne sait pas",
        "en": "Don't know"
      }
    },
    {
      "id": "ls_confirmation",
      "key": "confirmation",
      "kind": "boolean",
      "yes": {
        "fr": "Oui, je confirme",
        "en": "Yes, I confirm"
      },
      "no": {
        "fr": "Non, je corrige",
        "en": "No, I want to correct it"
      }
    }
  ]
}

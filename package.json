{
  "name": "editeur-questionnaires",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "smoke": "playwright test",
    "map": "node scripts/map.mjs",
    "guide": "node scripts/guide.mjs",
    "guide:check": "node scripts/guide.mjs --check",
    "check": "npm run typecheck && npm test && npm run deps && npm run guide:check && npm run build && npm run smoke",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.9.3",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "jsonata": "^1.8.9",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tinykeys": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questionnaire.schema.json",
  "title": "Questionnaire",
  "type": "object",
  "required": [
    "formatVersion",
    "kind",
    "id",
    "key",
    "title",
    "start",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "$ref": "common.schema.json#/$defs/formatVersion"
    },
    "kind": {
      "const": "questionnaire"
    },
    "id": {
      "type": "string"
    },
    "key": {
      "$ref": "common.schema.json#/$defs/key"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "status": {
      "description": "État de validation (EVO-015) : absent = draft (non validé) ; validated = validé par les métiers, livrable.",
      "enum": [
        "draft",
        "validated"
      ]
    },
    "validatedAt": {
      "description": "Date de validation (AAAA-MM-JJ), présente quand le questionnaire est validé.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "libraryVersions": {
      "description": "Versions de référence (EVO-022) : id de l'élément de bibliothèque utilisé (directement ou par un fragment) → version et statut. Fichier exporté : relevées à la dernière validation si le questionnaire est validé, sinon versions actuelles.",
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/versionRef"
      }
    },
    "start": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/edge"
      }
    }
  }
}

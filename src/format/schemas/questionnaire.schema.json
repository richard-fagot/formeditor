{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questionnaire.schema.json",
  "title": "Questionnaire",
  "type": "object",
  "required": [
    "formatVersion",
    "kind",
    "id",
    "key",
    "title",
    "start",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "$ref": "common.schema.json#/$defs/formatVersion"
    },
    "kind": {
      "const": "questionnaire"
    },
    "id": {
      "type": "string"
    },
    "key": {
      "$ref": "common.schema.json#/$defs/key"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "description": {
      "type": "string"
    },
    "start": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/edge"
      }
    }
  }
}

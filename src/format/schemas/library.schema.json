{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library.schema.json",
  "title": "Bibliothèque",
  "type": "object",
  "required": [
    "formatVersion",
    "kind",
    "questions",
    "fragments",
    "labelSets"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "$ref": "common.schema.json#/$defs/formatVersion"
    },
    "kind": {
      "const": "library"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/question"
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "key",
          "title",
          "nodes",
          "edges"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "$ref": "common.schema.json#/$defs/key"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/version"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/itemStatus"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localizedText"
          },
          "description": {
            "type": "string"
          },
          "entry": {
            "type": "string",
            "description": "Nœud d'entrée explicite (repli quand l'entrée implicite est absente ou ambiguë)."
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/node"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/edge"
            }
          }
        },
        "description": "Fragment de questionnaire : morceau de parcours sans départ ni fin. Entrée : `entry`, sinon le nœud sans arête entrante ; sorties : nœuds sans arête sortante."
      }
    },
    "labelSets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "key",
          "kind",
          "yes",
          "no"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "$ref": "common.schema.json#/$defs/key"
          },
          "kind": {
            "enum": [
              "boolean"
            ]
          },
          "yes": {
            "$ref": "common.schema.json#/$defs/localizedText"
          },
          "no": {
            "$ref": "common.schema.json#/$defs/localizedText"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}

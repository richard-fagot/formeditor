{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Projet",
  "type": "object",
  "required": [
    "formatVersion",
    "kind",
    "id",
    "name",
    "languages",
    "defaultLanguage",
    "systemState",
    "scenarios",
    "questionnaires"
  ],
  "additionalProperties": false,
  "$defs": {
    "variable": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/key"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "date",
            "boolean",
            "enum",
            "list"
          ]
        },
        "description": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Valeurs possibles d'une énumération (`type: enum`)."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "description": "Champs des objets d'une liste (`type: list`)."
        },
        "example": {
          "description": "Valeur d'exemple (documentation, autocomplétion)."
        }
      }
    }
  },
  "properties": {
    "formatVersion": {
      "$ref": "common.schema.json#/$defs/formatVersion"
    },
    "kind": {
      "const": "project"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/langCode"
      },
      "description": "Langues des contenus."
    },
    "defaultLanguage": {
      "$ref": "common.schema.json#/$defs/langCode",
      "description": "Langue de repli ; doit figurer dans `languages`."
    },
    "systemState": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "description": "Valeurs de l'état du système, par nom de variable (`sys.<nom>`)."
          }
        }
      }
    },
    "questionnaires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "Nom du fichier du questionnaire (`<clé>.json`), à côté de `projet.json`."
          }
        }
      }
    }
  }
}

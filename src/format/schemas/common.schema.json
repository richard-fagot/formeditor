{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Définitions communes",
  "$defs": {
    "expression": {
      "type": "string",
      "description": "Expression JSONata écrite avec les clés lisibles (docs/FORMAT.md)."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+$",
      "description": "Identifiant technique stable et opaque, sans « / » (réservé aux étapes `instance/nœud` des chemins). Jamais utilisé dans une expression."
    },
    "langCode": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)?$",
      "description": "Code de langue : `fr`, `en`, `pt-BR`…"
    },
    "localizedText": {
      "type": "object",
      "description": "Texte multilingue : une entrée par code de langue du projet. Langue absente = traduction manquante (repli sur la langue par défaut).",
      "propertyNames": {
        "$ref": "#/$defs/langCode"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "label": {
      "description": "Libellé interpolable ({cle}) : texte multilingue ou variantes conditionnelles.",
      "oneOf": [
        {
          "$ref": "#/$defs/localizedText"
        },
        {
          "type": "object",
          "required": [
            "variants",
            "otherwise"
          ],
          "additionalProperties": false,
          "properties": {
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "when",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "when": {
                    "$ref": "#/$defs/expression"
                  },
                  "text": {
                    "$ref": "#/$defs/localizedText"
                  }
                }
              }
            },
            "otherwise": {
              "$ref": "#/$defs/localizedText"
            }
          }
        }
      ]
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Clé lisible snake_case."
    },
    "numberBound": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/expression"
        }
      ]
    },
    "dateBound": {
      "type": "string",
      "description": "Date ISO littérale (AAAA-MM-JJ) ou expression."
    },
    "option": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "not": {
            "const": "other"
          },
          "description": "Valeur enregistrée dans la réponse ; `other` est réservée."
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "when": {
          "$ref": "#/$defs/expression"
        }
      }
    },
    "dynamicEntry": {
      "description": "Entrée dynamique : options issues d'une liste (réponse précédente, variable système), déployées à sa position. Reconnue à la présence de `from`.",
      "type": "object",
      "required": [
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/expression"
        },
        "label": {
          "$ref": "#/$defs/expression",
          "description": "Libellé affiché, évalué sur chaque élément."
        },
        "value": {
          "$ref": "#/$defs/expression",
          "description": "Valeur retenue, évaluée sur chaque élément."
        },
        "when": {
          "$ref": "#/$defs/expression"
        }
      }
    },
    "choiceItem": {
      "description": "Élément d'un groupe d'options : option statique ou entrée dynamique.",
      "oneOf": [
        {
          "$ref": "#/$defs/option"
        },
        {
          "$ref": "#/$defs/dynamicEntry"
        }
      ]
    },
    "choiceGroup": {
      "description": "Groupe d'options (EVO-003) : intitulé (libellé comme celui d'une option), code facultatif, condition d'affichage, options statiques et entrées dynamiques. Pas de groupe imbriqué. Reconnu à la présence de `group`.",
      "type": "object",
      "required": [
        "group",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "group": {
          "$ref": "#/$defs/label"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Identifiant du groupe dans la réponse (`<clé>_group`) ; défaut : le libellé dans la langue par défaut. `AUTRE` et `NSP` sont réservés."
        },
        "when": {
          "$ref": "#/$defs/expression"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choiceItem"
          }
        }
      }
    },
    "choiceEntry": {
      "description": "Entrée de la liste ordonnée des options : option statique, entrée dynamique ou groupe d'options.",
      "oneOf": [
        {
          "$ref": "#/$defs/option"
        },
        {
          "$ref": "#/$defs/dynamicEntry"
        },
        {
          "$ref": "#/$defs/choiceGroup"
        }
      ]
    },
    "otherOption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "detailRequired": {
          "type": "boolean"
        }
      }
    },
    "dontKnowOption": {
      "description": "Option « Ne sais pas » (EVO-006) : présente = activée. Libellé comme celui d'une option (défaut « Ne sais pas »). Réponse : valeur vide (`null`, `[]` pour `multiple`), marqueur `<clé>_nsp: true`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "question": {
      "description": "Question de la bibliothèque.",
      "allOf": [
        {
          "$ref": "#/$defs/questionCore"
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "date",
            "number",
            "single",
            "multiple",
            "boolean",
            "structure",
            "email",
            "phone",
            "address",
            "civility"
          ]
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "status": {
          "$ref": "#/$defs/itemStatus"
        }
      },
      "unevaluatedProperties": false
    },
    "structureField": {
      "description": "Champ de structure : question de tout type sauf structure, avec condition d'affichage `when` (évaluée dans l'occurrence).",
      "allOf": [
        {
          "$ref": "#/$defs/questionCore"
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "date",
            "number",
            "single",
            "multiple",
            "boolean",
            "email",
            "phone",
            "address",
            "civility"
          ]
        },
        "when": {
          "$ref": "#/$defs/expression"
        }
      },
      "unevaluatedProperties": false
    },
    "node": {
      "oneOf": [
        {
          "description": "Question locale (portée par le nœud).",
          "allOf": [
            {
              "$ref": "#/$defs/questionCore"
            }
          ],
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "question"
            }
          },
          "not": {
            "required": [
              "ref"
            ]
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id",
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "kind": {
              "const": "question"
            },
            "ref": {
              "type": "string"
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "hiddenFields": {
              "type": "array",
              "description": "Question structure (version 8) : clés des champs masqués dans cette instance ; absent = tous affichés. Une clé inconnue est ignorée.",
              "items": {
                "$ref": "#/$defs/key"
              },
              "uniqueItems": true
            },
            "required": {
              "type": "boolean",
              "description": "Version 10 (EVO-012) : surcharge du caractère obligatoire dans cet usage ; absent = hérité de la bibliothèque."
            }
          },
          "description": "Question de la bibliothèque, par référence ; libellé et caractère obligatoire surchargeables, champs d'une structure masquables."
        },
        {
          "description": "Instance (appel) d'un fragment de la bibliothèque, par référence : ses clés sont vues de l'appelant sous `alias.cle`.",
          "type": "object",
          "required": [
            "kind",
            "id",
            "ref",
            "alias"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "kind": {
              "const": "fragment"
            },
            "ref": {
              "type": "string"
            },
            "alias": {
              "$ref": "#/$defs/key"
            },
            "requiredOverrides": {
              "type": "object",
              "description": "Version 10 (EVO-012) : surcharges du caractère obligatoire des questions du fragment, par chemin d'identifiants de nœuds à partir du fragment appelé (`n_tel`, `n_appel/n_tel`) ; absent = hérité. Un chemin qui ne désigne aucune question est ignoré.",
              "propertyNames": {
                "pattern": "^[^/]+(/[^/]+)*$"
              },
              "additionalProperties": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "description": "Page d'information sans saisie.",
          "type": "object",
          "required": [
            "kind",
            "id",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "kind": {
              "const": "info"
            },
            "title": {
              "$ref": "#/$defs/label"
            },
            "text": {
              "$ref": "#/$defs/label"
            }
          }
        },
        {
          "description": "Page de synthèse des réponses du parcours effectif.",
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "kind": {
              "const": "summary"
            },
            "title": {
              "$ref": "#/$defs/label"
            }
          }
        },
        {
          "description": "Fin de parcours ; `outcome` est l'issue métier.",
          "type": "object",
          "required": [
            "kind",
            "id",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "kind": {
              "const": "end"
            },
            "title": {
              "$ref": "#/$defs/label"
            },
            "message": {
              "$ref": "#/$defs/label"
            },
            "outcome": {
              "type": "string"
            }
          }
        },
        {
          "description": "Version 15 (EVO-024) : nœud Renvoi, page de texte portant des boutons de renvoi (vers un autre questionnaire ou vers un nœud du questionnaire en cours), en plus de la navigation par ses arêtes sortantes.",
          "type": "object",
          "required": [
            "kind",
            "id",
            "text",
            "buttons"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "kind": {
              "const": "redirect"
            },
            "title": {
              "$ref": "#/$defs/label"
            },
            "text": {
              "$ref": "#/$defs/label"
            },
            "buttons": {
              "type": "array",
              "description": "Boutons de renvoi, dans l'ordre d'affichage.",
              "items": {
                "$ref": "#/$defs/redirectButton"
              }
            },
            "finishLabel": {
              "$ref": "#/$defs/label",
              "description": "Libellé du bouton Terminer (affiché à la place de « Suivant » quand toutes les arêtes sortantes mènent à une fin) ; absent = « Terminer »."
            }
          }
        },
        {
          "description": "Sortie nommée d'un fragment (facultative, uniquement dans un fragment de la bibliothèque).",
          "type": "object",
          "required": [
            "kind",
            "id",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "kind": {
              "const": "exit"
            },
            "name": {
              "$ref": "#/$defs/key"
            },
            "label": {
              "$ref": "#/$defs/localizedText"
            }
          }
        }
      ]
    },
    "redirectButton": {
      "type": "object",
      "description": "Version 15 (EVO-024) : bouton d'un nœud Renvoi. `target` absente = cible à choisir (signalée par l'éditeur).",
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "description": "Autre questionnaire du projet (déclaration) ; `prefill` et `replace` sont documentaires.",
              "required": [
                "questionnaire",
                "prefill",
                "replace"
              ],
              "additionalProperties": false,
              "properties": {
                "questionnaire": {
                  "type": "string",
                  "description": "Id du questionnaire visé."
                },
                "prefill": {
                  "type": "boolean",
                  "description": "Pré-remplissage de la cible."
                },
                "replace": {
                  "type": "boolean",
                  "description": "Annule et remplace le questionnaire en cours."
                }
              }
            },
            {
              "type": "object",
              "description": "Nœud du questionnaire en cours (retour pour corriger) : chemin d'ids, `n_type` ou `n_appel/n_question` pour une question de fragment.",
              "required": [
                "node"
              ],
              "additionalProperties": false,
              "properties": {
                "node": {
                  "type": "string",
                  "pattern": "^[^/]+(/[^/]+)*$"
                }
              }
            }
          ]
        },
        "when": {
          "$ref": "#/$defs/expression",
          "description": "Condition d'affichage ; absente = toujours affiché."
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "description": "Arête. Les arêtes sortant d'un même nœud sont évaluées dans l'ordre du tableau ; celle sans condition est le « sinon ».",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "type": "string",
          "description": "Id du nœud de départ (dans le même graphe)."
        },
        "to": {
          "type": "string",
          "description": "Id du nœud d'arrivée (dans le même graphe)."
        },
        "when": {
          "$ref": "#/$defs/expression",
          "description": "Condition ; absente = arête « sinon »."
        },
        "exit": {
          "type": "string",
          "description": "Arête sortant d'un nœud fragment : nom de la sortie nommée concernée ; absente = toute sortie (sorties implicites comprises)."
        },
        "caption": {
          "$ref": "#/$defs/caption"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]*$",
      "description": "Libellé de lecture, une ligne, une seule langue ; jamais affiché à l'utilisateur final, sans effet sur le comportement."
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "description": "Version (EVO-022) : texte libre géré à la main (convention X.Y.Z), sans contrôle de format ; absente = vide.",
      "type": "string"
    },
    "itemStatus": {
      "description": "Statut (EVO-022) : absent ou draft = provisoire ; validated = validé (« final »), version figée.",
      "enum": [
        "draft",
        "validated"
      ]
    },
    "versionRef": {
      "description": "Version de référence d'un élément de bibliothèque utilisé (EVO-022), relevée à la validation du questionnaire.",
      "type": "object",
      "required": [
        "version",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/itemStatus"
        }
      }
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Code pays ISO 3166-1 alpha-2 (`FR`, `BE`)."
    },
    "params_text": {
      "type": "object",
      "properties": {
        "multiline": {
          "type": "boolean"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "suggestions": {
          "$ref": "#/$defs/expression",
          "description": "Suggestions (EVO-016) : expression qui renvoie une liste de textes proposés à la saisie. Présente = option activée."
        }
      },
      "required": []
    },
    "params_date": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/dateBound"
        },
        "max": {
          "$ref": "#/$defs/dateBound"
        }
      },
      "required": []
    },
    "params_number": {
      "type": "object",
      "properties": {
        "numberKind": {
          "enum": [
            "real",
            "natural",
            "integer"
          ]
        },
        "min": {
          "$ref": "#/$defs/numberBound"
        },
        "max": {
          "$ref": "#/$defs/numberBound"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "$ref": "#/$defs/localizedText"
        }
      },
      "required": []
    },
    "params_single": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "description": "Entrées dans l'ordre d'affichage.",
          "items": {
            "$ref": "#/$defs/choiceEntry"
          }
        },
        "other": {
          "$ref": "#/$defs/otherOption"
        }
      },
      "required": [
        "options"
      ]
    },
    "params_multiple": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "description": "Entrées dans l'ordre d'affichage.",
          "items": {
            "$ref": "#/$defs/choiceEntry"
          }
        },
        "other": {
          "$ref": "#/$defs/otherOption"
        },
        "minSelected": {
          "type": "integer",
          "minimum": 0
        },
        "maxSelected": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "options"
      ]
    },
    "params_boolean": {
      "type": "object",
      "properties": {
        "labelSet": {
          "type": "string"
        },
        "other": {
          "$ref": "#/$defs/otherOption"
        }
      },
      "required": []
    },
    "params_structure": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureField"
          }
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "addLabel": {
              "$ref": "#/$defs/localizedText"
            }
          }
        }
      },
      "required": [
        "fields"
      ],
      "not": {
        "description": "Pas d'option « Ne sais pas » sur une structure (ses champs peuvent l'avoir).",
        "required": [
          "dontKnow"
        ]
      }
    },
    "params_email": {
      "type": "object",
      "description": "Mail (EVO-007) : RFC 5321 `Mailbox` (contrôle intégré `email`). Réponse : chaîne, nom de domaine en minuscules.",
      "properties": {
        "type": {
          "const": "email"
        }
      },
      "required": []
    },
    "params_phone": {
      "type": "object",
      "description": "Téléphone (EVO-007) : contrôles intégrés `phone` et `lineType`. Réponse : E.164 (`+33612345678`) ; pays sous `<clé>_pays`.",
      "properties": {
        "defaultCountry": {
          "$ref": "#/$defs/countryCode",
          "description": "Pays proposé au départ. Défaut : `FR`."
        },
        "countries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/countryCode"
          },
          "uniqueItems": true,
          "description": "Pays autorisés. Absent ou vide : tous."
        },
        "lineType": {
          "enum": [
            "mobile",
            "fixed"
          ],
          "description": "Type de ligne exigé. Absent : indifférent."
        }
      },
      "required": []
    },
    "params_address": {
      "type": "object",
      "description": "Adresse sur une ligne (EVO-007) : contrôles intégrés `address` et `postalCode` (France). Réponse : la ligne saisie ; pays sous `<clé>_pays`.",
      "properties": {
        "defaultCountry": {
          "$ref": "#/$defs/countryCode",
          "description": "Pays proposé au départ. Défaut : `FR`."
        },
        "countries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/countryCode"
          },
          "uniqueItems": true,
          "description": "Pays autorisés. Absent ou vide : tous."
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Longueur minimale. Défaut : 5."
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "description": "Longueur maximale. Défaut : 200."
        },
        "verify": {
          "type": "boolean",
          "description": "Adresse à vérifier par un service de normalisation (BAN pour la France, ou autre) : indicateur pour l'équipe de dev, non exécuté par l'outil."
        }
      },
      "required": []
    },
    "params_civility": {
      "type": "object",
      "description": "Civilité (EVO-007) : choix unique prédéfini. Réponse : code `MME`, `M` ou `NP`.",
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "description": "Libellés modifiés, par code (sinon libellés par défaut).",
          "properties": {

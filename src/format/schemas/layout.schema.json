{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layout.schema.json",
  "title": "Mise en page d'un graphe et commentaires de révision (outil seulement)",
  "type": "object",
  "required": [
    "formatVersion",
    "kind",
    "graph",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "$ref": "common.schema.json#/$defs/formatVersion"
    },
    "kind": {
      "const": "layout"
    },
    "graph": {
      "type": "string"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "collapsed": {
            "type": "boolean"
          }
        }
      }
    },
    "comments": {
      "description": "Commentaires de révision (EVO-011) : sans effet sur le questionnaire, à ignorer par le moteur.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node",
          "text",
          "replies"
        ],
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "replies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
